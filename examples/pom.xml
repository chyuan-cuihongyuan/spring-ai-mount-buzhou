<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.chyuan-cuihongyuan</groupId>
    <artifactId>spring-ai-mount-buzhou</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>buzhou-examples</artifactId>
  <name>buzhou-examples</name>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 全模块同版本由 buzhou-bom 统一 -->
      <dependency>
        <groupId>io.github.chyuan-cuihongyuan</groupId>
        <artifactId>buzhou-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      可运行 src/main demo（impl/05）：examples 是 Buzhou 的消费侧（非 feature 模块），
      demo 需 core + memory 编译期依赖以编程式装配。feature 模块互不直接依赖的硬约束（09）不受影响。
    -->
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-memory</artifactId>
    </dependency>
    <!--
      跨机制集成测试落于此（聚合侧）：feature 模块之间禁止直接依赖（09 模块工程档依赖白名单），
      涉及两个及以上 feature 模块的端到端测试只能由聚合模块承载。
    -->
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-skills</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-spill</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-guard</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-tools</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-observe-dashboard</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- ticket 21：四簇 demo 覆盖可观测回放与 MCP 热插拔，补两依赖 -->
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-observability</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-mcp</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
