<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.chyuan-cuihongyuan</groupId>
    <artifactId>spring-ai-mount-buzhou</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>buzhou-resilience</artifactId>
  <name>buzhou-resilience</name>

  <dependencies>
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-core</artifactId>
    </dependency>
    <!-- ResilienceAdvisor implements BaseAdvisor，挂 ChatClient advisor 链（模型调用重试/超时/错误归一化） -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-client-chat</artifactId>
    </dependency>
    <!-- 错误归一化分类：识别 RestClient 系 provider 的 HTTP 异常（状态码 / Retry-After 头） -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <!-- 自装配层（spec 09 / ticket 22）：@AutoConfiguration / @ConditionalOn* / @ConfigurationProperties -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- 装配测试 ApplicationContextRunner + 复用 core 测试工具（ScriptedChatModel） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
