<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.chyuan-cuihongyuan</groupId>
    <artifactId>spring-ai-mount-buzhou</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>buzhou-observe-dashboard</artifactId>
  <name>buzhou-observe-dashboard</name>

  <dependencyManagement>
    <dependencies>
      <!-- 全模块同版本由 buzhou-bom 统一 -->
      <dependency>
        <groupId>io.github.chyuan-cuihongyuan</groupId>
        <artifactId>buzhou-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      唯一允许的二层边（09 模块工程档白名单）：dashboard → observability。
      查询侧实际只消费 core.spi 的 ObservabilityStore/记录类型；Skill 管理页不依赖
      buzhou-skills——经本模块 SkillAdminPort SPI 由装配侧适配注入（03 档推演 #13）。
    -->
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-observability</artifactId>
    </dependency>
    <!-- 查询侧直接消费 core.spi 记录类型，显式声明而非靠传递依赖 -->
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-core</artifactId>
    </dependency>
    <!-- REST JSON 序列化 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <!-- 自装配层（ticket 22）：@AutoConfiguration / @ConditionalOn* -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- 装配测试 ApplicationContextRunner -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 复用 core 测试工具（ScriptedChatModel） -->
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
