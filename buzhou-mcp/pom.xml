<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.chyuan-cuihongyuan</groupId>
    <artifactId>spring-ai-mount-buzhou</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>buzhou-mcp</artifactId>
  <name>buzhou-mcp</name>

  <dependencies>
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-core</artifactId>
    </dependency>
    <!--
      MCP 原材料（spec 04：starter 只供协议/传输公开类，Harness 自建 client 生命周期注册表）：
      McpClient.sync / McpSyncClient / HttpClientStreamableHttpTransport / StdioClientTransport
      / SyncMcpToolCallbackProvider。传递引入 io.modelcontextprotocol.sdk:mcp（mcp-core）。
    -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-mcp</artifactId>
    </dependency>
    <!-- 自装配层（ticket 22）：@AutoConfiguration / @ConditionalOn* -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- 装配测试 ApplicationContextRunner + 复用 core 测试工具（ScriptedChatModel） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.chyuan-cuihongyuan</groupId>
      <artifactId>buzhou-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!--
      注意：不得在此加其他 feature 模块依赖（含 test scope）——09 模块工程档「feature 模块之间
      禁止直接依赖」是依赖白名单；可观测事件经 core 的 SpanRecorder SPI 注入。
    -->
      <!-- impl-51：JdbcToolSetSpecStore（optional——feature SPI 实现托管本模块，星形拓扑不破） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
