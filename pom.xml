<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.chyuan-cuihongyuan</groupId>
  <artifactId>spring-ai-mount-buzhou</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Spring AI Mount Buzhou</name>
  <description>Runtime harness mounted between Spring AI and business agents</description>
  <url>https://github.com/chyuan-cuihongyuan/spring-ai-mount-buzhou</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/chyuan-cuihongyuan/spring-ai-mount-buzhou</url>
    <connection>scm:git:https://github.com/chyuan-cuihongyuan/spring-ai-mount-buzhou.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/chyuan-cuihongyuan/spring-ai-mount-buzhou.git</developerConnection>
  </scm>

  <issueManagement>
    <system>github</system>
    <url>https://github.com/chyuan-cuihongyuan/spring-ai-mount-buzhou/issues</url>
  </issueManagement>

  <developers>
    <developer>
      <id>chyuan-cuihongyuan</id>
      <name>chyuan</name>
      <url>https://github.com/chyuan-cuihongyuan</url>
    </developer>
  </developers>

  <!-- 本机构建用阿里云镜像（绕过 repo.maven.apache.org 的 TLS 指纹拦截）：见仓库根 settings.xml，
       本机首次执行 `cp settings.xml ~/.m2/settings.xml`；CI（ubuntu-latest）直连 central，无需镜像。
       POM 不声明 repositories，避免已发布 POM 把镜像传染下游、且被 Central Portal 拒收。 -->

  <modules>
    <module>buzhou-bom</module>
    <module>buzhou-core</module>
    <module>buzhou-memory</module>
    <module>buzhou-spill</module>
    <module>buzhou-observability</module>
    <module>buzhou-observe-otel</module>
    <module>buzhou-observe-dashboard</module>
    <module>buzhou-skills</module>
    <module>buzhou-mcp</module>
    <module>buzhou-guard</module>
      <module>buzhou-resilience</module>
    <module>buzhou-tools</module>
    <module>buzhou-store-jdbc</module>
    <module>buzhou-store-redis</module>
    <module>buzhou-spring-boot-starter</module>
    <module>examples</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- impl-68 / spec 21：perf 基准默认排除；nightly workflow 以 -Dsurefire.excluded.groups= -Dgroups=perf 激活 -->
    <surefire.excluded.groups>perf</surefire.excluded.groups>
    <!-- impl-70 / spec 21：覆盖率硬门默认启用（BOM/starter/examples 在各自 pom 豁免） -->
    <jacoco.check.skip>false</jacoco.check.skip>
    <spring-ai.version>2.0.0</spring-ai.version>
    <spring-boot.version>4.1.0</spring-boot.version>
    <testcontainers.version>1.21.3</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.chyuan-cuihongyuan</groupId>
        <artifactId>buzhou-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.chyuan-cuihongyuan</groupId>
        <artifactId>buzhou-core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.github.chyuan-cuihongyuan</groupId>
        <artifactId>buzhou-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!--
        spec 44 §B / T160 / impl-131：三方版本分歧收口钉——spring-ai-client-chat 传递
        json-schema-validator 3.0.1 而 mcp sdk 传递 3.0.0；dependencyConvergence 门禁下显式取高者
        （校验器补版本向后兼容，3.0.1 含 errata 修复）。
      -->
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>3.0.6</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
          <configuration>
            <parameters>true</parameters>
            <encoding>UTF-8</encoding>
            <!--
              impl-52 / spec 14 §H：configuration-processor 全模块生效——
              @ConfigurationProperties 生成 spring-configuration-metadata.json，并与各模块
              additional-spring-configuration-metadata.json 在编译期合并（此前 additional 文件
              是死文件：全仓没有 processor，impl/43 手写元数据对 IDE 补全无效）。
              annotationProcessorPaths 独立于 dependencies 声明，不进消费方 classpath。
            -->
            <annotationProcessorPaths>
              <path>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-configuration-processor</artifactId>
                <version>${spring-boot.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
          <configuration>
            <!-- @{argLine} 迟占位：与 jaCoCo prepare-agent 注入的 agent 参数共存（impl-54） -->
            <argLine>-Dfile.encoding=UTF-8 @{argLine}</argLine>
            <!-- impl-68 / spec 21：perf 基准默认排除（nightly workflow 经 -Dgroups=perf 激活） -->
            <excludedGroups>${surefire.excluded.groups}</excludedGroups>
          </configuration>
        </plugin>
        <!-- 发布工程化（ticket 20）：以下插件仅在 release profile 激活时执行，版本在此统一锁定 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.8</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>0.11.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.6.3</version>
        </plugin>
        <!-- impl-54 / spec 14 §J：jaCoCo 覆盖率；impl-70 / spec 21：观测升硬门——LINE ≥ 70%
             （2026-08-15 实测 77.1%–90.9%，最紧模块留 7pp 余量；BOM/starter/examples 不适用，
             经 jacoco.check.skip=true 豁免——BOM 无代码、starter 纯聚合、examples 为演示模块）。 -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.15</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>enforce-line-coverage</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <skip>${jacoco.check.skip}</skip>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.70</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- impl-54：全模块 jaCoCo（prepare-agent + verify 期 report） -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <!--
        全模块同版本演进校验（ticket 20 验收项）：禁止在同一 POM 内对 io.github.chyuan-cuihongyuan
        的依赖声明不同版本。模块版本本身由父 POM 统一继承、BOM 以 ${project.version} 收口；
        本规则在 validate 阶段（含 CI verify）守门，捕获硬编码的版本漂移。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-buzhou-version-alignment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireSameVersions>
                  <dependencies>
                    <dependency>io.github.chyuan-cuihongyuan</dependency>
                  </dependencies>
                </requireSameVersions>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
          <!--
            spec 44 §B / T159 → T160 / impl-131：依赖治理收口——
            dependencyConvergence：三方依赖版本分歧（Maven 最近者胜出）转为硬失败，强制经 BOM/属性收口；
            banDuplicatePomDependencyVersions：同 POM 重复声明依赖即拒。
          -->
          <execution>
            <id>enforce-dependency-governance</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <dependencyConvergence/>
                <banDuplicatePomDependencyVersions/>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    release profile（ticket 20）：本地 `mvn -Prelease verify` 出齐 sources/javadoc/signature 构件；
    CI 打 tag 后 `mvn -Prelease deploy` 经 central-publishing-maven-plugin 上传 Central Portal staging。
    签名与上传凭证从环境变量读取（GPG_PASSPHRASE / CENTRAL_USERNAME / CENTRAL_TOKEN），见 RELEASING.md。
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <doclint>none</doclint>
              <charset>UTF-8</charset>
              <encoding>UTF-8</encoding>
              <docencoding>UTF-8</docencoding>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <passphrase>${env.GPG_PASSPHRASE}</passphrase>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- 首发人工确认：上传至 staging 后由 Portal 手动发布（spec 09 开放问题 #4）；
                   稳定后可改 autoPublish=true / waitUntil=published。 -->
              <autoPublish>false</autoPublish>
              <waitUntil>uploaded</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      supply-chain profile（T92 / impl-67）：CycloneDX 聚合 SBOM（json+xml 双出）。
      构建插件注记：cyclonedx-maven-plugin 非 10K★，但 CycloneDX 为行业标准 SBOM 格式、
      插件仅构建期生效、不进 runtime classpath（10K★ 政策豁免条款）。日常构建零开销，
      supply-chain workflow / 人工经 `mvn -Psupply-chain package` 触发。
    -->
    <profile>
      <id>supply-chain</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>2.9.3</version>
            <executions>
              <execution>
                <id>make-aggregate-bom</id>
                <phase>package</phase>
                <goals>
                  <goal>makeAggregateBom</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <outputFormat>all</outputFormat>
              <outputName>bom</outputName>
              <includeTestScope>false</includeTestScope>
              <skipProvidedScope>true</skipProvidedScope>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
