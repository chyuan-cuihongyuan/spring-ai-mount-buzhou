<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.chyuan-cuihongyuan</groupId>
  <artifactId>spring-ai-mount-buzhou</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Spring AI Mount Buzhou</name>
  <description>Runtime harness mounted between Spring AI and business agents</description>
  <url>https://github.com/chyuan-cuihongyuan/spring-ai-mount-buzhou</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/chyuan-cuihongyuan/spring-ai-mount-buzhou</url>
    <connection>scm:git:https://github.com/chyuan-cuihongyuan/spring-ai-mount-buzhou.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/chyuan-cuihongyuan/spring-ai-mount-buzhou.git</developerConnection>
  </scm>

  <issueManagement>
    <system>github</system>
    <url>https://github.com/chyuan-cuihongyuan/spring-ai-mount-buzhou/issues</url>
  </issueManagement>

  <developers>
    <developer>
      <id>chyuan-cuihongyuan</id>
      <name>chyuan</name>
      <url>https://github.com/chyuan-cuihongyuan</url>
    </developer>
  </developers>

  <!-- 本机构建用阿里云镜像（绕过 repo.maven.apache.org 的 TLS 指纹拦截）：见仓库根 settings.xml，
       本机首次执行 `cp settings.xml ~/.m2/settings.xml`；CI（ubuntu-latest）直连 central，无需镜像。
       POM 不声明 repositories，避免已发布 POM 把镜像传染下游、且被 Central Portal 拒收。 -->

  <modules>
    <module>buzhou-bom</module>
    <module>buzhou-core</module>
    <module>buzhou-memory</module>
    <module>buzhou-spill</module>
    <module>buzhou-observability</module>
    <module>buzhou-observe-otel</module>
    <module>buzhou-observe-dashboard</module>
    <module>buzhou-skills</module>
    <module>buzhou-mcp</module>
    <module>buzhou-guard</module>
    <module>buzhou-resilience</module>
    <module>buzhou-tools</module>
    <module>buzhou-store-jdbc</module>
    <module>buzhou-store-redis</module>
    <module>buzhou-spring-boot-starter</module>
    <module>examples</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-ai.version>2.0.0</spring-ai.version>
    <spring-boot.version>4.1.0</spring-boot.version>
    <testcontainers.version>1.21.3</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.chyuan-cuihongyuan</groupId>
        <artifactId>buzhou-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.chyuan-cuihongyuan</groupId>
        <artifactId>buzhou-core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.github.chyuan-cuihongyuan</groupId>
        <artifactId>buzhou-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
          <configuration>
            <parameters>true</parameters>
            <encoding>UTF-8</encoding>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.3</version>
          <configuration>
            <argLine>-Dfile.encoding=UTF-8</argLine>
          </configuration>
        </plugin>
        <!-- 发布工程化（ticket 20）：以下插件仅在 release profile 激活时执行，版本在此统一锁定 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.11.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.7</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>0.7.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        全模块同版本演进校验（ticket 20 验收项）：禁止在同一 POM 内对 io.github.chyuan-cuihongyuan
        的依赖声明不同版本。模块版本本身由父 POM 统一继承、BOM 以 ${project.version} 收口；
        本规则在 validate 阶段（含 CI verify）守门，捕获硬编码的版本漂移。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-buzhou-version-alignment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireSameVersions>
                  <dependencies>
                    <dependency>io.github.chyuan-cuihongyuan</dependency>
                  </dependencies>
                </requireSameVersions>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    release profile（ticket 20）：本地 `mvn -Prelease verify` 出齐 sources/javadoc/signature 构件；
    CI 打 tag 后 `mvn -Prelease deploy` 经 central-publishing-maven-plugin 上传 Central Portal staging。
    签名与上传凭证从环境变量读取（GPG_PASSPHRASE / CENTRAL_USERNAME / CENTRAL_TOKEN），见 RELEASING.md。
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <doclint>none</doclint>
              <charset>UTF-8</charset>
              <encoding>UTF-8</encoding>
              <docencoding>UTF-8</docencoding>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <passphrase>${env.GPG_PASSPHRASE}</passphrase>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- 首发人工确认：上传至 staging 后由 Portal 手动发布（spec 09 开放问题 #4）；
                   稳定后可改 autoPublish=true / waitUntil=published。 -->
              <autoPublish>false</autoPublish>
              <waitUntil>uploaded</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
